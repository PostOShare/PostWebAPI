{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostDefaultConnection": "mongodb://localhost:27017"
  },
  "ExternalAPISettings": {
    "IdentityAPIBaseUrl": "https://localhost:7224/",
    "ValidateAccessTokenEndpoint": "api/v1/auth/validate-accessToken"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "" //Add the path to the log file for info, fatal and error logs
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "" //Add the path to the log file for fatal and error logs
        }
      }
    ]
  }
}