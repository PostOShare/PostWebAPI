{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.JwtBearer": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostDefaultConnection": "mongodb://localhost:27017"
  },
  "ExternalAPISettings": {
    "IdentityAPIBaseUrl": "https://localhost:7224/",
    "ValidateAccessTokenEndpoint": "api/v1/auth/validate-accessToken"
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "LogPaths": {
    "InfoPath": "C://Users//deshd//Documents//IISWebAPIRepos//Logs//PostOSharePostWebAPI//info_YYYYMMDD.txt",
    "ErrorPath": "C://Users//deshd//Documents//IISWebAPIRepos//Logs//PostOSharePostWebAPI//error_YYYYMMDD.txt"
  },
  "Jwt": {
    "SecretKey": "my-super-secure-issuer-signing-key-2026",
    "Issuer": "https://www.postoshare.com/"
  },
  "APISettings": {
    "Timeout": "300"
  }
}